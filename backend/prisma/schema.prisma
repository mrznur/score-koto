generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Cricket ───────────────────────────────────────────────────────────────────

model CricketMatch {
  id           String   @id @default(uuid())
  providerId   String   @unique // cricapi match id
  name         String
  matchType    String   // t20, odi, test
  status       String
  venue        String?
  date         DateTime
  teams        Json     // string[]
  teamInfo     Json?    // [{ name, shortname, img }]
  score        Json?    // score array from API
  seriesId     String?
  matchStarted Boolean  @default(false)
  matchEnded   Boolean  @default(false)
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scorecard    CricketScorecard[]

  @@index([matchStarted, matchEnded])
  @@index([date])
}

model CricketScorecard {
  id        String       @id @default(uuid())
  matchId   String
  match     CricketMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  inning    String
  batting   Json
  bowling   Json
  extras    Json?
  totals    Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([matchId])
}

// ── Sync tracking ─────────────────────────────────────────────────────────────

model SyncLog {
  id        String   @id @default(uuid())
  provider  String   // football | cricket
  job       String   // live | fixtures | standings | scorecard
  status    String   // success | failed
  records   Int      @default(0)
  error     String?
  createdAt DateTime @default(now())

  @@index([provider, job])
  @@index([createdAt])
}

model ApiUsage {
  id        String   @id @default(uuid())
  provider  String
  date      String   // YYYY-MM-DD
  requests  Int      @default(0)
  limit     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, date])
}
