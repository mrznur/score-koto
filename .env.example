# ── Sports API keys ───────────────────────────────────────────────────────────
FOOTBALL_API_KEY=your_api_football_key_here
FOOTBALL_DATA_KEY=your_football_data_org_key_here
GOAL_API_KEY=your_goal_api_key_here
GOAL_API_DAILY_LIMIT=1000

CRICKET_API_KEY=your_cricketdata_primary_key_here
CRICKET_API_KEY_2=your_cricketdata_secondary_key_here_optional

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://scorekoto:scorekoto@localhost:5432/scorekoto

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=generate_with_openssl_rand_base64_32
JWT_EXPIRES_IN=7d

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
